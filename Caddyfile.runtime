{
	servers {
		protocols h1 h2
	}


cs.devopsflows.com {
	encode gzip
	reverse_proxy 127.0.0.1:18080 {
		header_up X-Forwarded-Proto https
		header_up Host {host}
		header_up X-Real-IP {remote_host}
		flush_interval -1
	}
}
}

berakha.devopsflows.com {
	encode gzip
	reverse_proxy 127.0.0.1:8080
}

erp.devopsflows.com {
	reverse_proxy 127.0.0.1:8081 {
		header_up X-Forwarded-Proto https
		header_up Host {host}
		flush_interval -1
	}
}

maya.devopsflows.com {
	reverse_proxy 127.0.0.1:3000 {
		header_up X-Forwarded-Proto https
		header_up Host {host}
	}
}

stockaes.devopsflows.com {
	encode gzip
	reverse_proxy 127.0.0.1:3010 {
		header_up X-Forwarded-Proto https
		header_up Host {host}
	}
}

maboutique.devopsflows.com {
	encode gzip
	reverse_proxy 127.0.0.1:3010 {
		header_up X-Forwarded-Proto https
